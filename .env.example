# Copy to .env and adjust: cp .env.example .env
# This file is committed. .env is not.

# --- Postgres (one instance, three databases) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-pg-super
PG_METABASE_PASSWORD=local-mb-pg
PG_DAGSTER_PASSWORD=local-dagster-pg
PG_SOURCE_PASSWORD=local-source-pg

# --- ClickHouse ---
CH_ADMIN_PASSWORD=local-ch-admin
CH_DAGSTER_PASSWORD=local-ch-dagster
CH_METABASE_PASSWORD=local-ch-metabase

# --- Metabase ---
# Must also live in the institution password manager in production.
# Without this key a pg_dump of the Metabase appdb restores into an unusable instance.
MB_ENCRYPTION_SECRET_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90112233445566778899aabbccddeeff00
MB_SITE_URL=http://localhost:3000
MB_ADMIN_EMAIL=admin@localhost.local
MB_ADMIN_FIRST_NAME=Local
MB_ADMIN_LAST_NAME=Admin
MB_ADMIN_PASSWORD=LocalDev123456

# --- Local source (Postgres stand-in for the SQL Server replica) ---
SOURCE_PG_HOST=postgres
SOURCE_PG_PORT=5432
SOURCE_PG_DB=source
SOURCE_PG_USER=source_reader

# --- ClickHouse client (used by Dagster) ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=dagster

# --- Archive ---
ARCHIVE_ROOT=/srv/dw/archive

# --- Pseudonymization pepper (marts boundary). Change in production. ---
PSEUDONYM_PEPPER=local-dev-pepper-not-for-prod
