# Copy to .env and adjust: cp .env.example .env
# This file is committed. .env is not.

# --- Postgres (one instance, three databases) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-pg-super
PG_METABASE_PASSWORD=local-mb-pg
PG_DAGSTER_PASSWORD=local-dagster-pg
PG_SOURCE_PASSWORD=local-source-pg

# --- ClickHouse ---
CH_ADMIN_PASSWORD=local-ch-admin
CH_DAGSTER_PASSWORD=local-ch-dagster
CH_METABASE_PASSWORD=local-ch-metabase
# Production compose.prod.yaml only. ~50–60% of host RAM, e.g. 12g on a 20 GB box.
# CH_MEM_LIMIT=8g

# --- Production orchestration limits ---
# Runs execute inside the daemon. Adjust after the server RAM is confirmed.
DAGSTER_WEBSERVER_MEM_LIMIT=1g
DAGSTER_DAEMON_MEM_LIMIT=4g

# --- Metabase ---
# Must also live in the institution password manager in production.
# Without this key a pg_dump of the Metabase appdb restores into an unusable instance.
MB_ENCRYPTION_SECRET_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90112233445566778899aabbccddeeff00
MB_SITE_URL=http://localhost:3000
MB_ADMIN_EMAIL=admin@localhost.local
MB_ADMIN_FIRST_NAME=Local
MB_ADMIN_LAST_NAME=Admin
MB_ADMIN_PASSWORD=LocalDev123456

# --- Local source (Postgres stand-in for the SQL Server replica) ---
SOURCE_PG_HOST=postgres
SOURCE_PG_PORT=5432
SOURCE_PG_DB=source
SOURCE_PG_USER=source_reader

# --- Production SQL Server read-only replica ---
# Replace every CHANGE_ME value before running compose.prod.yaml.
SOURCE_SQLSERVER_HOST=CHANGE_ME
SOURCE_SQLSERVER_PORT=1433
SOURCE_SQLSERVER_DB=CHANGE_ME
SOURCE_SQLSERVER_USER=CHANGE_ME
SOURCE_SQLSERVER_PASSWORD=CHANGE_ME
SOURCE_SQLSERVER_ENCRYPT=yes
SOURCE_SQLSERVER_TRUST_CERT=no

# --- ClickHouse client (used by Dagster) ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=dagster

# --- Archive ---
ARCHIVE_ROOT=/srv/dw/archive

# --- Extract ---
# Rows per chunk when streaming a source delta (memory bound per table).
# EXTRACT_CHUNK_ROWS=50000

# --- Alerts (docs/phases/08-operations.md) ---
# Local compose sends email to Mailpit regardless; these apply to compose.prod.yaml.
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_STARTTLS=yes
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Better Stack / Healthchecks.io heartbeat for the nightly (period 24h). Empty = off.
PIPELINE_HEARTBEAT_URL=
# Link in alert emails, e.g. https://dagster.dw.hospital.local
DAGSTER_BASE_URL=

# --- Pseudonymization pepper (marts boundary). Change in production. ---
PSEUDONYM_PEPPER=local-dev-pepper-not-for-prod
