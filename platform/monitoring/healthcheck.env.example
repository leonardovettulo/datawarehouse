# Copied to /etc/dw/healthcheck.env by prepare-host.sh (mode 600). Edit there.

# Heartbeat for the host itself. Better Stack: Uptime → Heartbeats → create with
# period 5 min, grace 5 min, and paste the URL here. Leave empty to only log.
HOST_HEARTBEAT_URL=

DW_DISK_PATHS="/srv/dw /"
DW_DISK_MAX_PCT=80
DW_MEM_MIN_AVAILABLE_PCT=10
DW_COMPOSE_PROJECTS="dw-platform dw-orchestration"
DW_EXPECTED_SERVICES="postgres clickhouse metabase dagster-webserver dagster-daemon"
